   "fieldname": "section_general",
   "fieldtype": "Section Break",
   "label": "Text",
   "description": "Applies to the content of every wiki page (not the sidebar or top bar). Leave a field empty to keep the wiki's default."
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Apply These Styles",
   "default": "1",
   "description": "Untick to switch all of these styles off."
  },
  {
   "fieldname": "font",
   "fieldtype": "Select",
   "label": "Font",
   "options": "Tahoma\nArial\nVerdana\nGeorgia\nTimes New Roman\nPoppins\nRoboto\nOpen Sans\nLato\nInter\nMontserrat\nNoto Sans\nSite Default\nCustom",
   "default": "Tahoma",
   "description": "Poppins, Roboto, Open Sans, Lato, Inter, Montserrat and Noto Sans are loaded from Google Fonts automatically."
  },
  {
   "fieldname": "custom_font",
   "fieldtype": "Data",
   "label": "Custom Font",
   "depends_on": "eval:doc.font==\"Custom\"",
   "mandatory_depends_on": "eval:doc.font==\"Custom\"",
   "description": "A font name, e.g. Nunito, or a CSS font list, e.g. \"Open Sans\", sans-serif."
